# Documentation template. go run does not automatically load this file.
ENV=development
# Default bind is loopback. Use all interfaces only with controlled ingress.
# WAYMARK_BIND_ADDR=0.0.0.0
WAYMARK_USERNAME=frodo
# Set a bcrypt hash via the environment, or use a file. Never put a plaintext password here.
# WAYMARK_PASSWORD_HASH_FILE=./password.hash
# WAYMARK_LOG_FILE=waymark.access.log
# Tracing is opt-in; omit OTEL_SERVICE_NAME to run without Jaeger.
# OTEL_SERVICE_NAME=waymark
# OTEL_EXPORTER_OTLP_TRACES_INSECURE=true
